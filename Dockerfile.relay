FROM golang:1.26.5-alpine AS build

WORKDIR /src/go
COPY go/go.mod go/go.sum ./
RUN go mod download
COPY go/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/gorelay ./cmd/gorelay

FROM alpine:3.22
RUN apk add --no-cache ca-certificates \
    && addgroup -S agent-sync \
    && adduser -S -G agent-sync agent-sync
COPY --from=build /out/gorelay /usr/local/bin/gorelay
USER agent-sync
ENV AGENT_SYNC_HOST=0.0.0.0
EXPOSE 8799
ENTRYPOINT ["/usr/local/bin/gorelay"]
